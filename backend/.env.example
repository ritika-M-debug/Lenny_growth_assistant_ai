# Application Configuration
APP_NAME="The Lenny Growth Assistant"
ENVIRONMENT="development"
DEBUG=True
PORT=8000

# Database Configuration (PostgreSQL)
# Copy this file to backend/.env and replace placeholders with your actual PostgreSQL credentials.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lenny_growth_db
DATABASE_URL=postgresql://postgres:your_db_password_here@localhost:5432/lenny_growth_db

# Active LLM Provider: "ollama" (default local), "anthropic" (cloud), or "mock" (offline test)
LLM_PROVIDER=ollama

# Local LLM Configuration (Ollama)
# Base URL for local Ollama daemon
OLLAMA_BASE_URL=http://localhost:11434
# Example models: llama3.2:3b (fast, lightweight), llama3:8b (recommended PM quality), mistral:7b
OLLAMA_MODEL=llama3.2:3b
# Request timeout in seconds
OLLAMA_TIMEOUT=60.0

# Cloud LLM Configuration (Anthropic Claude) - OPTIONAL
# Required only if LLM_PROVIDER=anthropic. NEVER commit real API keys!
ANTHROPIC_API_KEY=
# Example models: claude-3-5-sonnet-20241022 (high intelligence), claude-3-haiku-20240307 (fast)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_TIMEOUT=60.0
ANTHROPIC_MAX_RETRIES=2

# Explicit fallback provider (optional, disabled by default to avoid silent switching)
# Set to "ollama" if you want automatic fallback when Anthropic is unavailable
LLM_FALLBACK_PROVIDER=

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
