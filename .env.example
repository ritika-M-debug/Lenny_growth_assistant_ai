# ==============================================================================
# The Lenny Growth Assistant - Docker Compose Environment Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env at the root of the project:
#    cp .env.example .env (or `copy .env.example .env` on Windows PowerShell)
# 2. Modify any settings below as needed.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True

# ------------------------------------------------------------------------------
# PostgreSQL Database (Docker Compose service name: db)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lenny_growth_db
POSTGRES_SERVER=db
POSTGRES_PORT=5432

# Host port mapped to PostgreSQL container (5433 avoids conflict with host Postgres on 5432)
POSTGRES_HOST_PORT=5433

# Full Database Connection URL
DATABASE_URL=postgresql://postgres:postgres@db:5432/lenny_growth_db

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# Supported options: "ollama" (default local), "anthropic" (cloud), "mock" (offline tests)
# ------------------------------------------------------------------------------
LLM_PROVIDER=ollama

# ------------------------------------------------------------------------------
# Local Ollama Configuration
# ------------------------------------------------------------------------------
# When accessing Ollama running on your host machine from inside the Docker container:
# - Windows & macOS (Docker Desktop): http://host.docker.internal:11434
# - Linux: http://host.docker.internal:11434 (supported via extra_hosts in compose)
# When running Ollama as a Docker service (via `docker compose --profile ollama up`):
# - Use: http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=60.0

# ------------------------------------------------------------------------------
# Cloud Anthropic Claude Configuration (OPTIONAL)
# Required only if LLM_PROVIDER=anthropic. NEVER commit real API keys!
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_TIMEOUT=60.0
ANTHROPIC_MAX_RETRIES=2

# Explicit fallback provider (optional, disabled by default to prevent silent provider switching)
LLM_FALLBACK_PROVIDER=

# ------------------------------------------------------------------------------
# Port Mappings & Frontend Configuration
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Browser-accessible backend API base URL (used by client browser, NOT container-to-container)
VITE_API_BASE_URL=http://localhost:8000

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://127.0.0.1:5173
